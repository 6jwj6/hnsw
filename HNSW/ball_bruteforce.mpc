from Compiler.library import *
from Compiler.compilerLib import Compiler
from Compiler.types import *
from Compiler.oram import *
from Programs.Source.HNSW.HeapQ import MinHeapQ,MaxHeapQ
import time
from Compiler.mpc_math import *
from Compiler.sorting import reveal_sort
def bruteforce_for_query_sort_array_updated(q_idx):
    # print_ln("\n优化的暴力搜索结果:")
    start_timer(666)
    s = sint.Array(N+1)
    s.assign_all(0)
    tmp = sint.Array(N+1)
    @for_range_opt(D)
    def _(i):
        tmp.assign_all(querynode[q_idx][i])
        v = node_brt.get_vector_by_indices(None, i) - tmp
        v = v * v
        s.assign(s + v)
    s = s.to_column_matrix()
    x = sint.Tensor([N+1,1])
    x.assign(regint.inc(size = N+1))
    sQ = x.concat_columns(s)
    # print_ln('%s', type(sQ))
    sQ.sort(key_indices=[1])
    sQ = sQ.get_vector_by_indices(None, 0)[:K:]
    stop_timer(666)
    return sQ

N = 100000
D = 32
K = 1
node_brt = sint.Tensor([N + 1, D])
querynode = sint.Tensor([1, D])
res = bruteforce_for_query_sort_array_updated(0)
